{
  "version": 1,
  "name": "电子竞技",
  "canvas": { "width": 1920, "height": 1080 },
  "theme": {
    "accent": "#FFC24B",
    "live": "#FF4D4D",
    "ink": "#F2F4F8",
    "inkDim": "#9AA4B2",
    "panelTop": "#1A2030E6",
    "panelBottom": "#0C1018F0",
    "border": "#FFFFFF40",
    "home": "#4C9AFF",
    "away": "#FF6B6B",
    "font": ""
  },
  "safe": { "x": 26, "y": 22 },
  "elements": [
    {
      "id": "ticker",
      "type": "ticker",
      "label": "跑马灯",
      "visible": true,
      "scenes": ["full", "compact"],
      "anchor": "bottomLeft",
      "x": 0,
      "y": 0,
      "width": 1920,
      "height": 53,
      "scale": 1.0,
      "opacity": 1.0,
      "style": { "fontScale": 1.0, "uppercase": false },
      "anim": { "enter": "fade", "update": "none", "durationMs": 350, "easing": "outCubic" }
    },
    {
      "id": "frame",
      "type": "frame",
      "label": "安全框",
      "visible": true,
      "scenes": ["full", "compact"],
      "anchor": "topLeft",
      "x": 0,
      "y": 0,
      "width": 0,
      "height": 0,
      "scale": 1.0,
      "opacity": 1.0,
      "style": { "fontScale": 1.0, "uppercase": false },
      "anim": { "enter": "none", "update": "none", "durationMs": 0, "easing": "linear" }
    },
    {
      "id": "bug",
      "type": "matchBug",
      "label": "比赛角标",
      "visible": true,
      "scenes": [],
      "anchor": "topLeft",
      "x": 26,
      "y": 22,
      "width": 346,
      "height": 0,
      "scale": 1.0,
      "opacity": 1.0,
      "style": { "fontScale": 1.0, "uppercase": false },
      "anim": { "enter": "slideDown", "update": "pop", "durationMs": 420, "easing": "outCubic" }
    },
    {
      "id": "event",
      "type": "eventInfo",
      "label": "赛事信息",
      "visible": true,
      "scenes": ["full", "compact"],
      "anchor": "topRight",
      "x": 26,
      "y": 22,
      "width": 432,
      "height": 0,
      "scale": 1.0,
      "opacity": 1.0,
      "style": { "fontScale": 1.0, "uppercase": false },
      "anim": { "enter": "slideDown", "update": "pop", "durationMs": 420, "easing": "outCubic" }
    },
    {
      "id": "lower",
      "type": "lowerThird",
      "label": "选手条",
      "visible": true,
      "scenes": ["full"],
      "anchor": "bottomLeft",
      "x": 26,
      "y": 0,
      "width": 768,
      "height": 0,
      "scale": 1.0,
      "opacity": 1.0,
      "style": { "fontScale": 1.0, "uppercase": false },
      "anim": { "enter": "slideLeft", "update": "pop", "durationMs": 550, "easing": "outCubic" }
    },
    {
      "id": "timer",
      "type": "timer",
      "label": "计时器",
      "visible": true,
      "scenes": [],
      "anchor": "bottomRight",
      "x": 26,
      "y": 0,
      "width": 0,
      "height": 0,
      "scale": 1.0,
      "opacity": 1.0,
      "style": { "fontScale": 1.0, "uppercase": false },
      "anim": { "enter": "slideUp", "update": "flash", "durationMs": 420, "easing": "outCubic" }
    },
    {
      "id": "announce",
      "type": "announcement",
      "label": "公告",
      "visible": true,
      "scenes": ["full"],
      "anchor": "center",
      "x": 0,
      "y": -130,
      "width": 0,
      "height": 0,
      "scale": 1.0,
      "opacity": 1.0,
      "style": { "fontScale": 1.0, "uppercase": true },
      "anim": { "enter": "scaleIn", "update": "pop", "durationMs": 480, "easing": "outBack" }
    }
  ]
}
