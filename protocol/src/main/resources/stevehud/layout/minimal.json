    {
      "id": "bug",
      "type": "matchBug",
      "label": "比赛角标",
      "visible": true,
      "scenes": [],
      "anchor": "topLeft",
      "x": 20,
      "y": 18,
      "width": 300,
      "height": 0,
      "scale": 1.0,
      "opacity": 0.96,
      "style": { "fontScale": 0.92, "uppercase": false },
      "anim": { "enter": "fade", "update": "pop", "durationMs": 320, "easing": "outCubic" }
    },
    {
      "id": "timer",
      "type": "timer",
      "label": "计时器",
      "visible": true,
      "scenes": [],
      "anchor": "bottomRight",
      "x": 20,
      "y": 0,
      "width": 0,
      "height": 0,
      "scale": 1.0,
      "opacity": 0.96,
      "style": { "fontScale": 0.9, "uppercase": false },
      "anim": { "enter": "fade", "update": "flash", "durationMs": 320, "easing": "outCubic" }
