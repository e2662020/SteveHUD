{
  "version": 1,
  "name": "极简",
  "canvas": { "width": 1920, "height": 1080 },
  "theme": {
    "accent": "#8AB4F8",
    "live": "#FF5C5C",
    "ink": "#EDF1F7",
    "inkDim": "#8E9AAB",
    "panelTop": "#141A24E0",
    "panelBottom": "#0A0E14EE",
    "border": "#FFFFFF2E",
    "home": "#7AA2F7",
    "away": "#F7768E",
    "font": ""
  },
  "safe": { "x": 20, "y": 18 },
